MONGO_URI=mongodb://127.0.0.1:27017/new-project
JWT_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
REDIS_URL=redis://127.0.0.1:6379
REFRESH_TOKEN_TTL_SECONDS=604800
FRONTEND_URL=http://localhost:5173
PORT=3000
KITSU_API_URL=https://kitsu.io/api/edge
# Public anime-listing cache time: 5 minutes.
ANIME_CACHE_TTL_SECONDS=300
NODE_ENV=development
# Optional trusted reverse proxy addresses, e.g. 127.0.0.1 or 10.0.0.0/8.
# Leave empty when the backend is accessed directly.
TRUST_PROXY=
